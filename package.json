{
  "name": "hxblock-desktop",
  "productName": "HXBlock Desktop",
  "description": "HXBlock as a self-contained desktop application",
  "author": {
    "name": "haoxuekeji",
    "email": "support@haoxuekeji.com"
  },
  "version": "2.3.2-beta",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/patch-dmg-builder.js",
    "clean": "rimraf ./dist ./static ./external-resources ./tools ./translations ./firmwares ./drivers",
    "i18n:src": "mkdirp translations/core && format-message extract --out-file translations/core/en.json src/main/**.js",
    "i18n:push": "tx-push-src openblock-editor desktop translations/core/en.json",
    "start": "mkdirp ./dist && electron-webpack dev --bail --display-error-details --env.minify=false --no-progress",
    "compile": "mkdirp ./dist && electron-webpack --bail --display-error-details --env.minify=false --no-progress",
    "fetch:drivers": "rimraf ./drivers && node scripts/download-driver.js",
    "fetch:exts": "node scripts/sync-local-resources.js",
    "fetch:firmwares": "rimraf ./firmwares && node ./node_modules/openblock-link/script/download-firmwares.js",
    "fetch:tools": "rimraf ./tools && node ./node_modules/openblock-link/script/download-tools.js && npm run prune:tools",
    "prune:tools": "rimraf ./tools/Arduino/packages/rp2040 ./tools/Arduino/packages/esp8266 ./tools/Arduino/packages/esp32 ./tools/Arduino/packages/Maixduino",
    "fetch:static": "rimraf ./static && mkdirp ./static && git clone https://github.com/openblockcc/openblock-assets.git static && rimraf ./static/.git",
    "fetch:all": "npm run fetch:drivers && npm run fetch:exts && npm run fetch:firmwares && npm run fetch:tools && npm run fetch:static",
    "setup:local-deps": "node scripts/setup-local-deps.js",
    "setup:local-deps:check": "node scripts/setup-local-deps.js --check",
    "build": "npm run build:dev",
    "build:dev": "npm run compile && npm run doBuild -- --mode=dev",
    "build:dir": "npm run compile && npm run doBuild -- --mode=dir",
    "build:dist": "npm run compile && npm run doBuild -- --mode=dist",
    "build:publish": "npm run compile && npm run doBuild -- --mode=publish",
    "build:win": "npm run compile && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 --config",
    "build:mac": "npm run compile && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --config -c.mac.identity=null",
    "build:linux": "npm run compile && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux AppImage deb dir --config",
    "build:linux:dir": "npm run compile && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux dir --config -c.compression=store",
    "rebuild": "electron-rebuild --platform=win32 --arch=x64",
    "setup:linux-tools": "bash scripts/setup-linux-tools.sh",
    "upload:releaseInfo": "node ./scripts/upload-release-info.mjs",
    "doBuild": "node ./scripts/electron-builder-wrapper.js",
    "dist": "npm run clean && npm run compile && npm run fetch:all && npm run doBuild -- --mode=dist",
    "publish": "npm run clean && npm run compile && npm run fetch:all  && npm run doBuild -- --mode=publish",
    "test": "npm run test:lint",
    "test:lint": "eslint --cache --color --ext .jsx,.js src scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/haoxuekeji/openblock-desktop.git"
  },
  "dependencies": {
    "bytes": "^3.1.2",
    "css-loader": "^1.0.1",
    "openblock-link": "git+https://github.com/haoxuekeji/openblock-link.git#main-haoxue",
    "openblock-resource": "git+https://github.com/haoxuekeji/openblock-resource.git#main-haoxue",
    "postinstall": "^0.7.4",
    "source-map-support": "^0.5.19"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.53.1",
    "@babel/core": "^7.9.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.9.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-async-to-generator": "^7.8.3",
    "@babel/preset-env": "^7.9.6",
    "@babel/preset-react": "^7.9.4",
    "@electron/remote": "^2.0.5",
    "async": "^3.2.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.1.0",
    "babel-plugin-react-intl": "^7.5.7",
    "compare-versions": "^3.6.0",
    "copy-webpack-plugin": "^5.1.1",
    "download-github-release": "^0.3.2",
    "electron": "^22.3.27",
    "electron-builder": "^22.13.1",
    "electron-devtools-installer": "^3.2.0",
    "electron-fetch": "^1.7.4",
    "electron-log": "^4.4.6",
    "electron-notarize": "^1.1.1",
    "electron-store": "^8.0.1",
    "electron-updater": "^4.6.5",
    "electron-webpack": "^2.8.2",
    "eslint": "^7.0.0",
    "eslint-config-scratch": "^6.0.0",
    "eslint-plugin-import": "^2.20.0",
    "eslint-plugin-react": "^7.20.0",
    "format-message": "^6.2.3",
    "format-message-cli": "^6.2.3",
    "fs-extra": "^9.0.1",
    "intl": "1.2.5",
    "lodash.bindall": "^4.4.0",
    "lodash.defaultsdeep": "^4.6.1",
    "minilog": "^3.1.0",
    "minimist": "^1.2.5",
    "mkdirp": "^1.0.4",
    "monaco-editor-webpack-plugin": "^1.7.0",
    "nets": "^3.2.0",
    "node-abort-controller": "^3.0.1",
    "node-fetch": "^3.2.1",
    "openblock-gui": "github:haoxuekeji/openblock-gui.git#desktop-haoxue",
    "hxblock-l10n": "latest",
    "openblock-parse-release-message": "0.0.4",
    "os-locale": "^5.0.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-intl": "2.9.0",
    "react-redux": "5.0.7",
    "redux": "3.7.2",
    "rimraf": "^3.0.2",
    "uuid": "^8.3.2",
    "webpack": "^4.43.0",
    "electron-rebuild": "^3.2.7"
  },
  "main": "main.js",
  "electronWebpack": {
    "main": {
      "sourceDirectory": "src/main",
      "webpackConfig": "webpack.main.js"
    },
    "renderer": {
      "sourceDirectory": "src/renderer",
      "template": "src/renderer/index.html",
      "webpackConfig": "webpack.renderer.js"
    }
  }
}
